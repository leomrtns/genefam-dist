\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  SPR-chain simulation with missing taxa. MDS projections use signatures calculated from informed reference trees drawn from the SPR chain (left) or random reference trees (right). Colours denote four groups sampled from separated portions of the chain. The plot is one exploratory realisation; points do not represent independent simulation replicates. }}{8}{figure.caption.2}\protected@file@percent }
\newlabel{figure002}{{2}{8}{SPR-chain simulation with missing taxa. MDS projections use signatures calculated from informed reference trees drawn from the SPR chain (left) or random reference trees (right). Colours denote four groups sampled from separated portions of the chain. The plot is one exploratory realisation; points do not represent independent simulation replicates}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Genome-level simulation}{8}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  One SimPhy realisation. The upper image compares MDS, t-SNE, Isomap, and nearest-neighbour spectral embeddings of the tree signatures; colours denote the four generating species trees. The lower image summarises gene-tree leaf counts, species coverage, and pairwise species overlap. Axis coordinates in the embeddings have no direct biological units. }}{9}{figure.caption.3}\protected@file@percent }
\newlabel{figure003}{{3}{9}{One SimPhy realisation. The upper image compares MDS, t-SNE, Isomap, and nearest-neighbour spectral embeddings of the tree signatures; colours denote the four generating species trees. The lower image summarises gene-tree leaf counts, species coverage, and pairwise species overlap. Axis coordinates in the embeddings have no direct biological units}{figure.caption.3}{}}
